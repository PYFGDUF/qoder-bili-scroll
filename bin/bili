#!/bin/sh
# 调试/运维 CLI。日常使用优先走 MCP 工具与斜杠命令。
set -eu

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
PLUGIN_ROOT=$(dirname "$SCRIPT_DIR")

export PYTHONUTF8=1
export PYTHONIOENCODING=utf-8
export PYTHONDONTWRITEBYTECODE=1

PY=$("$SCRIPT_DIR/bootstrap.sh") || exit $?
exec "$PY" "$PLUGIN_ROOT/bin/lib/cli.py" "$@"
